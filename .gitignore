bin/
obj/
*.user

# HexiumDist: the DLL copy and packed zip are build output that changes every release and would
# bloat history if committed - manifest.json/README.md/CHANGELOG.md/icon.png are authored source
# and stay tracked (same convention as Fatty and other Wubarrk mods).
*.zip
HexiumDist/plugins/*.dll
HexiumDist/*-v*/

# Server logs copied in for diagnosis - never part of the mod
*.log
